{
  "name": "react-float-avatar",
  "version": "0.2.0",
  "description": "可拖拽的浮动 AI 头像：边缘锚定 + 四角吸附 + 消息气泡 + 红点角标（React + antd）",
  "keywords": [
    "antd",
    "assistant",
    "avatar",
    "badge",
    "bubble",
    "draggable",
    "floating",
    "react"
  ],
  "homepage": "https://github.com/susususutie/react-float-avatar#readme",
  "bugs": {
    "url": "https://github.com/susususutie/react-float-avatar/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/susususutie/react-float-avatar.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "test": "vp test",
    "check": "vp check",
    "prepack": "vp pack"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "antd": "^6.6.4",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "antd": "^6.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  }
}
